{
  "name": "pacs",
  "version": "0.1.0",
  "private": true,
  "description": "Parking Allocation Context System — monorepo. Spec of record: ../analisis.html rev 2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "migrate:up": "pnpm --filter @pacs/api migrate:up",
    "migrate:down": "pnpm --filter @pacs/api migrate:down",
    "dev": "pnpm --filter @pacs/api dev",
    "deploy:dev": "pnpm --filter @pacs/api deploy:dev"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.9"
}
