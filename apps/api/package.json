{
  "name": "@pacs/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "PACS backend — Lambda + API Gateway HTTP API, Clean Architecture per module (analisis.html §10)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src migrations",
    "migrate:up": "node-pg-migrate up -m migrations -j ts --tsconfig tsconfig.json",
    "migrate:down": "node-pg-migrate down -m migrations -j ts --tsconfig tsconfig.json",
    "seed": "tsx scripts/seed.ts",
    "local": "node scripts/local-api.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:plates": "node scripts/smoke-plates.mjs",
    "gate-user": "node scripts/create-gate-user.mjs",
    "clean:smoke": "node scripts/clean-smoke-data.mjs",
    "set-admin": "node scripts/set-admin-flag.mjs",
    "brand": "node scripts/apply-login-branding.mjs",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "remove:dev": "serverless remove --stage dev"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.12.0",
    "@aws-lambda-powertools/metrics": "^2.12.0",
    "@aws-lambda-powertools/tracer": "^2.12.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.709.0",
    "@aws-sdk/client-dynamodb": "^3.709.0",
    "@aws-sdk/client-rekognition": "^3.709.0",
    "@aws-sdk/client-s3": "^3.709.0",
    "@aws-sdk/client-secrets-manager": "^3.709.0",
    "@aws-sdk/lib-dynamodb": "^3.709.0",
    "@aws-sdk/rds-signer": "^3.709.0",
    "@aws-sdk/s3-request-presigner": "^3.709.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1146.0",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9",
    "node-pg-migrate": "^7.9.0",
    "serverless": "4.43.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "vitest": "^2.1.8"
  }
}
