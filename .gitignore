# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.angular/
.esbuild/
*.tsbuildinfo

# serverless
.serverless/
.serverless_plugins/

# secrets and local config — never commit
.env
.env.local
.env.*.local
*.pem
secrets/

# test output
coverage/
.vitest/
test-results/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Playwright diagnostic output (screenshots, console dumps)
apps/web/diagnose-out/
apps/web/test-results/

# The renderer writes an intermediate HTML next to each PDF: 2.7 MB apiece, with the
# whole mermaid bundle inlined, and regenerated on every run.
docs/delivery/*.html
